---
import '../styles/global.css';
const {title,description='Personalised tutoring for children aged 11–16 in Leicestershire. A clear plan, thoughtful support and progress together.'}=Astro.props;
const links=[['/','Home'],['/services/','Services'],['/tutors/','About tutors'],['/testimonials/','Testimonials'],['/contact/','Contact']];
---
<!doctype html><html lang="en-GB"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content="noindex,nofollow"/><title>{title} | Tutoring Leicestershire</title><link rel="icon" href="/favicon.svg"/></head><body><a class="skip" href="#main">Skip to content</a><header><a class="brand" href="/"><span class="brand-icon">t.</span><span>Tutoring<small>LEICESTERSHIRE</small></span></a><nav aria-label="Main navigation">{links.map(([href,label])=><a href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}</nav><a class="button small" href="/contact/">Let’s talk →</a></header><main id="main"><slot/></main><section class="closing"><div><p class="eyebrow">A good place to begin</p><h2>A clear plan starts<br/>with a conversation.</h2><p>Tell us where your child is now, and where you’d like them to be.</p></div><a class="button light" href="/contact/">Talk about your child’s goals ↗</a></section><footer><a class="brand" href="/"><span class="brand-icon">t.</span><span>Tutoring<small>LEICESTERSHIRE</small></span></a><p>Thoughtful support. Personal progress.<br/>For families across Leicestershire.</p><div><a href="/contact/">Contact</a><a href="/privacy/">Enquiry privacy</a><small>© {new Date().getFullYear()} Tutoring · Website draft</small></div></footer></body></html>
